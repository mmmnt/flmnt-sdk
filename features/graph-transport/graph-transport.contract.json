{
  "$schema": "https://mmmnt.dev/feat/contract.schema.json",
  "specId": "SPEC-SDK-003",
  "schemas": {
    "QueryMemoryInput": {
      "type": "object",
      "required": ["document"],
      "properties": {
        "document": { "type": "string" },
        "variables": { "type": "object" }
      },
      "additionalProperties": false
    },
    "GraphResult": {
      "type": "object",
      "required": ["data"],
      "properties": { "data": {} },
      "additionalProperties": false
    },
    "WireCall": {
      "type": "object",
      "required": ["method", "path"],
      "properties": {
        "method": { "type": "string" },
        "path": { "type": "string" },
        "body": { "type": "object" }
      },
      "additionalProperties": false
    },
    "SdkError": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "enum": ["SDK_KEY_MALFORMED", "SDK_EXCHANGE_REFUSED", "SDK_GRAPH_REFUSED", "SDK_NETWORK"] },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
