    execute (as anonymous) AcquireToken { apiKey: "flmnt_sk_conn_sib1.s3cr3t-value_x" }
    seed wire [wire.stub with WireCall { method: "STUB", path: "/graphql", body: { status: 200, data: { memoryStream: { streamId: "ws-sibling::domain", entryCount: 3 } } } }]
  when (as anonymous): GetStreamMetadata { streamId: "ws-sibling::domain" }
  predict success:
    response 200 SdkResult { result: { streamId: "ws-sibling::domain", entryCount: 3 } }
