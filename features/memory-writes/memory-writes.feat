feat 1.0

spec SPEC-SDK-005 "Every typed write builds its router mutation and passes the receipt through untouched"
context Sdk
aggregate Memory
type command
status agreed

construct:
  handler at features/memory-writes/handler.ts
  touches features/**
  touches src/**
  needs SPEC-SDK-003
  The typed write surface mirrors the MCP's write tools over the router GraphQL mutations
  (QRM-ADR-002 §8). The router is the sole policy-enforcement point — the SDK never
  pre-authorizes, meters, or resolves stream ids beyond composing {workspaceId}::{type}
  singletons the way the MCP does. Receipts pass through untouched.

enforce:
  A write method never fabricates a receipt — the response is the mutation's field value
  verbatim, and a router refusal surfaces through SPEC-SDK-003's transport law.
  recordMistake composes its singleton stream id ({workspaceId}::mistake) from the
  CALLER-SUPPLIED workspace id — the SDK holds no ambient workspace; every other method
  takes the full streamId the caller resolved.

contract:
  input RecordEntryArgs
  input KeyframeWriteArgs
  input MistakeArgs
  input SupersessionArgs
  input PlanWriteArgs
  input MetricArgs
  input CreateStreamArgs
  response SdkResult
  record WireCall

scenario "recordEntry rides recordMemoryEntry":
  given:
    execute (as anonymous) AcquireToken { apiKey: "flmnt_sk_conn_sib1.s3cr3t-value_x" }
    seed wire [wire.stub with WireCall { method: "STUB", path: "/graphql", body: { status: 200, data: { recordMemoryEntry: { entryId: "e-new" } } } }]
  when (as anonymous): RecordEntry { streamId: "ws-sibling::domain", content: "Use PostgreSQL", kind: "decision", causalRefs: ["e0"] }
  predict success:
    response 200 SdkResult { result: { entryId: "e-new" } }
    wire has [http.request with WireCall { method: "POST", path: "/graphql", body: { query: matching "recordMemoryEntry" } }]

