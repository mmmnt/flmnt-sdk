scenario "recordMistake composes the mistake singleton and rides recordMemoryMistake":
  given:
    execute (as anonymous) AcquireToken { apiKey: "flmnt_sk_conn_sib1.s3cr3t-value_x" }
    seed wire [wire.stub with WireCall { method: "STUB", path: "/graphql", body: { status: 200, data: { recordMemoryMistake: { entryId: "m-new" } } } }]
  when (as anonymous): RecordMistake { workspaceId: "ws-sibling", content: "wrong region; fixed", wasCorrected: true }
  predict success:
    response 200 SdkResult { result: { entryId: "m-new" } }
    wire has [http.request with WireCall { method: "POST", path: "/graphql", body: { query: matching "recordMemoryMistake", variables: { streamId: "ws-sibling::mistake" } } }]

